{
  "hosting": {
    "public": "dist",
    "cleanUrls": true,
    "trailingSlash": true,
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/media/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://nmlosqhywrxpcqlfuhcp.supabase.co; media-src 'self' blob: https://nmlosqhywrxpcqlfuhcp.supabase.co; connect-src 'self' https://nmlosqhywrxpcqlfuhcp.supabase.co wss://nmlosqhywrxpcqlfuhcp.supabase.co https://open.er-api.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
          }
        ]
      },
      {
        "source": "/admin/**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          },
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/projetos{,/**}",
        "destination": "/#projetos",
        "type": 301
      },
      {
        "source": "/trajetoria{,/**}",
        "destination": "/#trajetoria",
        "type": 301
      },
      {
        "source": "/competencias{,/**}",
        "destination": "/#trajetoria",
        "type": 301
      },
      {
        "source": "/contato{,/**}",
        "destination": "/#contato",
        "type": 301
      },
      {
        "source": "/en/projetos{,/**}",
        "destination": "/en/#projetos",
        "type": 301
      },
      {
        "source": "/en/trajetoria{,/**}",
        "destination": "/en/#trajetoria",
        "type": 301
      },
      {
        "source": "/en/competencias{,/**}",
        "destination": "/en/#trajetoria",
        "type": 301
      },
      {
        "source": "/en/contato{,/**}",
        "destination": "/en/#contato",
        "type": 301
      },
      {
        "source": "/es/projetos{,/**}",
        "destination": "/es/#projetos",
        "type": 301
      },
      {
        "source": "/es/trajetoria{,/**}",
        "destination": "/es/#trajetoria",
        "type": 301
      },
      {
        "source": "/es/competencias{,/**}",
        "destination": "/es/#trajetoria",
        "type": 301
      },
      {
        "source": "/es/contato{,/**}",
        "destination": "/es/#contato",
        "type": 301
      }
    ]
  }
}
